{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "gamey/**/*.ts",
    "training/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts"
  ]
}